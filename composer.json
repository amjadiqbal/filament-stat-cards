{
    "name": "amjadiqbal/filament-stat-cards",
    "description": "Richer stat cards for the Filament 4 and 5 stats overview widget: progress bars, icon tiles, background, label and value colours, trends, badges and bar charts.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "laravel",
        "widget",
        "stats",
        "stats-overview",
        "dashboard",
        "kpi",
        "progress-bar"
    ],
    "homepage": "https://github.com/amjadiqbal/filament-stat-cards",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/filament-stat-cards/issues",
        "source": "https://github.com/amjadiqbal/filament-stat-cards"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FilamentStatCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FilamentStatCards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FilamentStatCards\\FilamentStatCardsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
